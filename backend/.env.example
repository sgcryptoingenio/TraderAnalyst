# URL de conexión a la base de datos PostgreSQL (Render, Supabase, Neon, etc.)
DATABASE_URL=postgresql://usuario:contraseña@servidor.com:5432/nombre_db

# (Opcional) URL del frontend para CORS en producción. Si se omite, se permiten todos (*).
FRONTEND_URL=https://tu-frontend.vercel.app

# Clave secreta para JWT de FastAPI (ej: genera una usando `openssl rand -hex 32`)
SECRET_KEY=tu_clave_super_secreta
